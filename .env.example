# PromoPilot AI configuration. Copy to .env.local and fill in. Never commit real keys.
# All values are read server-side (API routes and CLI) only. Nothing here is exposed to the browser.

# Which provider to use: anthropic | gemini | openai-compatible | openai | none
#   openai-compatible = any API with the OpenAI chat-completions shape (set OPENAI_COMPAT_* below)
#   openai            = same, with the base URL defaulting to OpenAI
#   none              = heuristic-only mode (rule-based estimates, no AI analysis)
AI_PROVIDER=anthropic

# Model ID for the selected provider (required unless AI_PROVIDER=none). Examples only:
#   anthropic: claude-opus-5-5, claude-sonnet-5-5, claude-haiku-5-5
#   gemini:    any Gemini model ID your key can access via the OpenAI-compatible endpoint
#   openai-compatible: whatever model ID that API expects
AI_MODEL=claude-opus-5-5

# Provider keys. Only the key for the selected provider is needed.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional: Anthropic reasoning effort (low | medium | high). Leave empty for the model default.
# "low" keeps each request short, which suits Vercel function limits.
AI_EFFORT=low

# Optional: override the Gemini OpenAI-compatible base URL.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# For AI_PROVIDER=openai-compatible: base URL (ending before /chat/completions) and key.
# OPENAI_COMPAT_BASE_URL=https://your-endpoint.example.com/v1
# OPENAI_COMPAT_API_KEY=
# json_schema (default) | json_object | none. Use json_object or none if the server rejects JSON-schema requests.
# OPENAI_COMPAT_RESPONSE_FORMAT=json_schema

# Optional: per-request timeout for one LLM call, in milliseconds (default 55000).
# AI_TIMEOUT_MS=55000

# Optional: protects the AI API routes on a public deployment. When set, the web UI asks for
# this code before running AI analysis. Heuristic mode always works without it.
APP_ACCESS_CODE=
